{
  "name": "remidio-eqms",
  "version": "1.0.0",
  "description": "Electronic Quality Management System for Remidio",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop ecosystem.config.cjs",
    "restart:pm2": "pm2 restart ecosystem.config.cjs",
    "status:pm2": "pm2 status",
    "logs:pm2": "pm2 logs",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "migrate": "cd backend && npm run migrate",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test"
  },
  "keywords": [
    "eqms",
    "quality-management",
    "medical-device",
    "fda",
    "iso13485"
  ],
  "author": "Remidio",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^5.3.0"
  }
}
